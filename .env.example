# SurfGen environment — copy to .env and adjust.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://surfgen:surfgen-dev@127.0.0.1:5432/surfgen

# Queues & events
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
AMQP_URL=amqp://surfgen:surfgen-dev@127.0.0.1:5672

# Auth (REQUIRED unless NODE_ENV is development or test)
JWT_SECRET=change-me-in-production

# Billing — 32-byte key (base64 or hex) that seals the Paystack secret key at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SURFGEN_ENCRYPTION_KEY=
# Absolute origin of the web app — used for Paystack checkout callback redirects.
# PUBLIC_WEB_URL=http://localhost:3000

# Remote deploys (docker-compose.full.yml)
# PUBLIC_API_URL: the API address the BROWSER can reach — baked into the web
#   bundle at image build time, e.g. http://<server-ip>:4000 or https://api.example.com
# COOKIE_SECURE=false: only for plain-http trials on a raw IP (browsers reject
#   Secure cookies over http). Remove once behind HTTPS.
# CORS_ORIGINS: comma-separated allowlist, e.g. http://<server-ip>:3000
# TRUST_PROXY=true: only set this when a reverse proxy (nginx, a load
#   balancer) sits in front and strips/sets X-Forwarded-For itself. Leaving
#   this unset (the default) when exposing the API directly is required —
#   otherwise any client can spoof the header to bypass rate limiting.
# RATE_LIMIT_MAX: requests/minute per IP for most routes (default 300).
# RATE_LIMIT_AUTH_MAX: requests/minute per IP for login/register/
#   resend-verification/refresh specifically (default 10) — kept far lower
#   since these are the routes brute-force/enumeration attacks target.
# PUBLIC_API_URL=
# COOKIE_SECURE=
# CORS_ORIGINS=
# TRUST_PROXY=
# RATE_LIMIT_MAX=
# RATE_LIMIT_AUTH_MAX=

# S3 storage (used when config/storage.yaml driver = s3)
SURFGEN_S3_ACCESS_KEY=surfgen
SURFGEN_S3_SECRET_KEY=surfgen-dev

# Google SSO (optional — login/signup show the button only when configured)
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and register the redirect URI <PUBLIC_API_URL>/v1/auth/google/callback
# (http://localhost:4000/v1/auth/google/callback for local dev).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  # only when the callback differs from the derived default

# Email verification (signup flow)
# REQUIRE_EMAIL_VERIFICATION=true blocks login until the address is confirmed.
# Without SMTP_HOST the verification link is logged by the API instead of sent.
# REQUIRE_EMAIL_VERIFICATION=false
# PUBLIC_WEB_URL=http://localhost:3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SurfGen <no-reply@yourdomain.com>

# Optional cloud AI providers (uncomment config/ai.yaml entries to use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# DEEPL_API_KEY=
# HEYGEN_API_KEY=

# Observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
