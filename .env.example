# SurfGen environment — copy to .env and adjust.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://surfgen:surfgen-dev@127.0.0.1:5432/surfgen

# Queues & events
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
AMQP_URL=amqp://surfgen:surfgen-dev@127.0.0.1:5672

# Auth (REQUIRED in production)
JWT_SECRET=change-me-in-production

# Remote deploys (docker-compose.full.yml)
# PUBLIC_API_URL: the API address the BROWSER can reach — baked into the web
#   bundle at image build time, e.g. http://<server-ip>:4000 or https://api.example.com
# COOKIE_SECURE=false: only for plain-http trials on a raw IP (browsers reject
#   Secure cookies over http). Remove once behind HTTPS.
# CORS_ORIGINS: comma-separated allowlist, e.g. http://<server-ip>:3000
# PUBLIC_API_URL=
# COOKIE_SECURE=
# CORS_ORIGINS=

# S3 storage (used when config/storage.yaml driver = s3)
SURFGEN_S3_ACCESS_KEY=surfgen
SURFGEN_S3_SECRET_KEY=surfgen-dev

# Optional cloud AI providers (uncomment config/ai.yaml entries to use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# DEEPL_API_KEY=
# HEYGEN_API_KEY=

# Observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
