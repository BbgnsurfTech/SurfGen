{
  "name": "@surfgen/queue",
  "version": "0.1.0",
  "description": "SurfGen job queues — BullMQ wrappers, pipeline stage definitions, progress protocol",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "zod": "catalog:",
    "nanoid": "catalog:",
    "@surfgen/core": "workspace:*",
    "@surfgen/telemetry": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
