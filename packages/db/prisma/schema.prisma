// SurfGen database schema — PostgreSQL 16, Prisma 6.
// Conventions: cuid ids; org-scoped rows carry organizationId; soft delete via
// deletedAt; createdAt/updatedAt everywhere; enums for closed state sets that
// mirror the domain state machines in @surfgen/core.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  locale       String    @default("en")
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships   Membership[]
  teamMembers   TeamMember[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  notifications Notification[]
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]

  @@index([email])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // google | github | oidc
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      String    @default("free")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships     Membership[]
  teams           Team[]
  projects        Project[]
  apiKeys         ApiKey[]
  videos          Video[]
  assets          Asset[]
  templates       Template[]
  avatars         Avatar[]
  voices          Voice[]
  workflows       Workflow[]
  webhooks        Webhook[]
  usageRecords    UsageRecord[]
  quotas          Quota[]
  billingAccount  BillingAccount?
  auditLogs       AuditLog[]
  providerConfigs ProviderConfig[]

  @@index([slug])
}

enum OrgRole {
  owner
  admin
  editor
  viewer
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(editor)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String?
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  videos       Video[]
  workflows    Workflow[]

  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  /// SHA-256 of the full key; plaintext shown once at creation.
  keyHash        String    @unique
  /// First 8 chars for display ("sg_live_ab12…").
  keyPrefix      String
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
}

// ---------------------------------------------------------------------------
// Content: videos, scenes, timeline, assets, templates
// ---------------------------------------------------------------------------

enum VideoStatus {
  draft
  queued
  generating
  rendering
  post_processing
  ready
  failed
  cancelled
  archived
}

model Video {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String
  createdById    String?
  title          String
  description    String?
  status         VideoStatus @default(draft)
  language       String      @default("en")
  /// VideoRenderSettings JSON (resolution, frameRate, container, codec, quality).
  settings       Json
  /// Final output: { media, thumbnail, captions, durationMs } storage refs.
  output         Json?
  /// Declarative pipeline definition used for generation.
  pipeline       Json?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes       Scene[]
  pipelineRuns PipelineRun[]

  @@index([organizationId, status])
  @@index([projectId])
}

model Scene {
  id        String   @id @default(cuid())
  videoId   String
  order     Int
  /// Scene content: script text, avatarId, voiceId, background, transitions.
  content   Json
  durationMs Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video  Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tracks TimelineTrack[]

  @@unique([videoId, order])
}

enum TrackKind {
  video
  audio
  text
  image
  shape
  captions
  music
}

model TimelineTrack {
  id        String    @id @default(cuid())
  sceneId   String
  kind      TrackKind
  order     Int
  locked    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  scene Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  clips TimelineClip[]

  @@unique([sceneId, order])
}

model TimelineClip {
  id       String @id @default(cuid())
  trackId  String
  assetId  String?
  startMs  Int
  endMs    Int
  /// Clip payload: transform, effects, text content, animation params.
  properties Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  track TimelineTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  asset Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([trackId])
}

enum AssetKind {
  image
  video
  audio
  font
  subtitle
  motion
  other
}

model Asset {
  id             String    @id @default(cuid())
  organizationId String
  kind           AssetKind
  name           String
  storageKey     String    @unique
  contentType    String
  sizeBytes      Int
  durationMs     Int?
  width          Int?
  height         Int?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clips        TimelineClip[]

  @@index([organizationId, kind])
}

model Template {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  /// Full editor document with {{variable}} placeholders.
  document       Json
  thumbnailKey   String?
  isPublic       Boolean   @default(false)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variables    TemplateVariable[]

  @@index([organizationId])
}

enum TemplateVariableKind {
  text
  image
  video
  audio
  color
  url
  json
}

model TemplateVariable {
  id           String               @id @default(cuid())
  templateId   String
  key          String
  kind         TemplateVariableKind
  label        String
  defaultValue Json?
  required     Boolean              @default(false)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
}

// ---------------------------------------------------------------------------
// Avatars & voices
// ---------------------------------------------------------------------------

enum AvatarKind {
  photo
  video
  three_d
  animated_character
}

model Avatar {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  kind           AvatarKind
  /// Provider that hosts/animates this avatar (config id).
  providerId     String?
  /// Provider-scoped external id, when hosted remotely.
  externalId     String?
  isPublic       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     AvatarVersion[]

  @@index([organizationId])
}

model AvatarVersion {
  id           String   @id @default(cuid())
  avatarId     String
  version      Int
  /// Identity source material storage keys + provider training artifacts.
  artifacts    Json
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@unique([avatarId, version])
}

model Voice {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  language       String
  /// Provider config id serving this voice.
  providerId     String
  /// Provider-scoped voice id (e.g. ElevenLabs voice id or local model name).
  externalId     String
  isCloned       Boolean   @default(false)
  previewKey     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clones       VoiceClone[]

  @@index([organizationId])
}

model VoiceClone {
  id            String    @id @default(cuid())
  voiceId       String
  /// Storage keys of consent artifact + training samples.
  consentKey    String
  sampleKeys    String[]
  status        String    @default("pending") // pending | training | ready | failed
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  voice Voice @relation(fields: [voiceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Workflows & pipeline execution
// ---------------------------------------------------------------------------

model Workflow {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  /// Node-graph definition (same declarative format as pipelines).
  definition     Json
  version        Int       @default(1)
  isEnabled      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  runs         WorkflowRun[]

  @@index([organizationId])
}

enum RunStatus {
  pending
  running
  completed
  failed
  cancelled
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  status     RunStatus @default(pending)
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
}

model PipelineRun {
  id             String    @id @default(cuid())
  videoId        String
  organizationId String
  status         RunStatus @default(pending)
  /// Snapshot of the declarative pipeline definition executed.
  definition     Json
  /// Stage-name → artifact refs produced so far (resume checkpoint).
  artifacts      Json      @default("{}")
  priority       String    @default("normal")
  correlationId  String?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  jobs  Job[]

  @@index([videoId])
  @@index([organizationId, status])
}

enum JobStatus {
  queued
  active
  progress
  retrying
  completed
  failed
  cancelled
}

model Job {
  id            String    @id @default(cuid())
  pipelineRunId String
  stage         String
  queue         String
  status        JobStatus @default(queued)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  /// BullMQ job id for cross-referencing.
  externalJobId String?
  progress      Json?
  error         Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId, stage])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Providers, models, plugins
// ---------------------------------------------------------------------------

model ProviderConfig {
  id             String   @id @default(cuid())
  /// Null = platform-wide config; set = per-org override.
  organizationId String?
  providerId     String // matches providers.json / plugin provider id
  capability     String
  enabled        Boolean  @default(true)
  priority       Int      @default(100)
  /// Non-secret option overrides (secrets stay in the secret manager).
  options        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId])
  @@index([capability])
}

model ModelRecord {
  id           String   @id @default(cuid())
  modelId      String   @unique
  providerId   String
  capability   String
  /// Discovered locally (Ollama, ComfyUI, …) vs statically configured.
  discovered   Boolean  @default(false)
  parameters   Json?
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([capability])
}

model Plugin {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String
  description String
  /// Validated plugin.manifest.json snapshot.
  manifest    Json
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Webhooks, usage, billing
// ---------------------------------------------------------------------------

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  /// Events subscribed, AMQP-style patterns ("video.*").
  events         String[]
  /// HMAC secret reference (never plaintext).
  secretRef      String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  eventId      String
  eventName    String
  payload      Json
  status       String    @default("pending") // pending | delivered | failed
  attempts     Int       @default(0)
  responseCode Int?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@unique([webhookId, eventId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String // render.seconds | tts.characters | llm.tokens | storage.bytes
  quantity       Float
  providerId     String?
  runId          String?
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, occurredAt])
}

model Quota {
  id             String   @id @default(cuid())
  organizationId String
  metric         String
  limit          Float
  /// Rolling window in seconds (e.g. 2592000 = 30 days).
  windowSeconds  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric])
}

model BillingAccount {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  provider         String   @default("stripe")
  externalCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]
}

model Subscription {
  id               String    @id @default(cuid())
  billingAccountId String
  plan             String
  status           String // active | past_due | canceled | trialing
  externalId       String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
}

model Invoice {
  id               String   @id @default(cuid())
  billingAccountId String
  externalId       String?
  amountCents      Int
  currency         String   @default("usd")
  status           String // draft | open | paid | void
  issuedAt         DateTime @default(now())

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Audit, notifications, outbox
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // e.g. "video.create", "provider.update"
  resource       String
  resourceId     String?
  /// Request context: ip, userAgent, changes diff.
  context        Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // video.ready | video.failed | quota.warning | system
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Transactional outbox — see @surfgen/events OutboxRelay.
model OutboxEvent {
  id          String    @id @default(cuid())
  envelope    Json
  attempts    Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}
