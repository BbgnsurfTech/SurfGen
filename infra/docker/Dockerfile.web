# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
# NEXT_PUBLIC_* is baked into the client bundle at build time — the browser
# calls this URL, so it must be the API address reachable FROM THE USER'S
# machine (e.g. http://<server-ip>:4000), not an internal compose hostname.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Root layout metadataBase. Also NEXT_PUBLIC_*, so it is inlined at build time —
# left unset, Open Graph URLs resolve against localhost.
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
COPY . .
RUN pnpm install --frozen-lockfile && \
    pnpm turbo build --filter=@surfgen/web

FROM node:22-alpine AS runtime
RUN addgroup -S surfgen && adduser -S surfgen -G surfgen
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
COPY --from=build --chown=surfgen:surfgen /app/apps/web/.next/standalone ./
COPY --from=build --chown=surfgen:surfgen /app/apps/web/.next/static ./apps/web/.next/static
USER surfgen
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:3000/ || exit 1
CMD ["node", "apps/web/server.js"]
