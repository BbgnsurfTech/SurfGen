{
  "uid": "surfgen-overview",
  "title": "SurfGen Overview",
  "tags": ["surfgen"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    { "type": "row", "title": "Pipeline", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "timeseries",
      "title": "Jobs processed / min by stage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "uid": "surfgen-prom" },
      "targets": [
        {
          "expr": "sum by (stage) (rate(surfgen_jobs_processed_total[5m])) * 60",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failure rate (all stages)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "uid": "surfgen-prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(surfgen_jobs_processed_total{status=\"failed\"}[10m])) / clamp_min(sum(rate(surfgen_jobs_processed_total[10m])), 1e-9)",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage duration p95",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "uid": "surfgen-prom" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(surfgen_job_duration_seconds_bucket[10m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    { "type": "row", "title": "Providers", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "type": "timeseries",
      "title": "Provider latency p95 by provider",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "uid": "surfgen-prom" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(surfgen_provider_latency_seconds_bucket[10m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider failures / min (failover pressure)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "uid": "surfgen-prom" },
      "targets": [
        {
          "expr": "sum by (provider, capability) (rate(surfgen_provider_failures_total[5m])) * 60",
          "legendFormat": "{{provider}} ({{capability}})"
        }
      ]
    },
    { "type": "row", "title": "Fleet", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },
    {
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 19 },
      "datasource": { "uid": "surfgen-prom" },
      "targets": [{ "expr": "sum by (job) (up)", "legendFormat": "{{job}}" }]
    },
    {
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 19 },
      "datasource": { "uid": "surfgen-prom" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "{{job}} {{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event-loop lag p95",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 19 },
      "datasource": { "uid": "surfgen-prom" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "nodejs_eventloop_lag_p95_seconds", "legendFormat": "{{job}} {{instance}}" }
      ]
    }
  ]
}
