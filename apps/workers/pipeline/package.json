    "@surfgen/events": "workspace:*",
    "@surfgen/plugin-sdk": "workspace:*",
    "@surfgen/queue": "workspace:*",
    "@surfgen/storage": "workspace:*",
    "@surfgen/telemetry": "workspace:*",
    "@prisma/client": "^6.11.0",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
