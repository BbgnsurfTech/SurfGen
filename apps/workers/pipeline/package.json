{
  "name": "@surfgen/worker-pipeline",
  "version": "0.1.0",
  "description": "SurfGen pipeline workers — orchestrator, AI stages, ffmpeg media stages",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
