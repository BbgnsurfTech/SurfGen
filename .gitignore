# dependencies
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/

# builds
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/

# env & secrets
.env
.env.*
!.env.example
# Per-target templates (e.g. infra/docker/.env.hostinger.example) hold only
# placeholders — .env.* above would otherwise swallow them.
!.env.*.example
*.pem
*.key

# runtime artifacts
tmp/
*.log
storage/local/
prisma/*.db

# IDE / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars

# playwright
playwright-report/
test-results/
